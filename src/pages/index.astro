---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Rooms from "../components/Rooms.astro";
import Gallery from "../components/Gallery.astro";
import landscapeImage from "../assets/photos/arequipa-landscape.webp";
import balconiesImage from "../assets/photos/hotel-balconies.webp";

const services = [
  ["01", "Desayuno local", "Productos de temporada y sabores arequipeños cada mañana."],
  ["02", "Anfitriones cercanos", "Recomendaciones honestas para descubrir la ciudad a tu manera."],
  ["03", "Traslado coordinado", "Te ayudamos a organizar tu llegada desde el aeropuerto o terminal."],
  ["04", "Wi-Fi de alta velocidad", "Conexión estable en habitaciones y espacios comunes."],
];
---

<Layout title="Casa Theo — Hotel boutique en Arequipa" description="Descubre Casa Theo, un hotel boutique de arquitectura en sillar, habitaciones serenas y hospitalidad cercana en el corazón de Arequipa.">
  <Hero />

  <section class="container-page grid gap-12 py-24 sm:py-30 lg:grid-cols-[.75fr_1.25fr] lg:gap-24 lg:py-40" id="la-casa">
    <div class="lg:pt-3">
      <p class="eyebrow">La casa</p>
      <p class="font-serif text-2xl leading-snug text-pine">Aquí, la historia no se exhibe.<br />Se habita.</p>
    </div>
    <div>
      <h2 class="font-serif text-[clamp(2.8rem,5.3vw,5.1rem)] leading-[1.02] tracking-[-.045em]">Una pausa luminosa entre el sillar y el cielo arequipeño.</h2>
      <div class="mt-9 grid gap-8 sm:grid-cols-2">
        <p class="leading-7 text-muted">Casa Theo recupera el espíritu de una antigua casona y lo transforma en una experiencia sencilla, cálida y contemporánea.</p>
        <p class="leading-7 text-muted">A pocos pasos del centro histórico, cada patio invita a bajar el ritmo y a mirar Arequipa desde un lugar más íntimo.</p>
      </div>
    </div>
  </section>

  <section class="grid min-h-[620px] bg-pine text-white lg:grid-cols-2" id="experiencias">
    <div class="relative min-h-[480px] overflow-hidden lg:min-h-full">
      <img class="absolute inset-0 size-full object-cover object-center" src={landscapeImage.src} alt="Vicuña frente al paisaje volcánico de los Andes arequipeños" width={landscapeImage.width} height={landscapeImage.height} loading="lazy" decoding="async" />
    </div>
    <div class="flex items-center px-5 py-20 sm:px-10 lg:px-[clamp(4rem,8vw,9rem)] lg:py-28">
      <div class="max-w-xl">
        <p class="eyebrow !text-sand">El arte de quedarse</p>
        <h2 class="font-serif text-[clamp(2.8rem,5vw,5rem)] leading-[.96] tracking-[-.045em]">Días lentos.<br />Recuerdos vivos.</h2>
        <p class="mt-7 max-w-lg leading-7 text-white/65">Del primer café en el patio a una caminata entre conventos y picanterías, diseñamos cada recomendación para acercarte al carácter real de la ciudad.</p>
        <a class="button-light mt-9" href="#ubicacion">Explorar Arequipa</a>
      </div>
    </div>
  </section>

  <Rooms />

  <Gallery />

  <section class="bg-[#efe8dd] py-24 lg:py-32" aria-labelledby="servicios-title">
    <div class="container-page">
      <div class="grid gap-8 border-b border-[#cfc4b5] pb-10 lg:grid-cols-2">
        <div><p class="eyebrow">Todo lo esencial</p><h2 class="font-serif text-[clamp(2.8rem,5vw,4.8rem)] leading-none" id="servicios-title">Cuidado en cada detalle.</h2></div>
        <p class="max-w-lg self-end leading-7 text-muted lg:justify-self-end">Servicios pensados para que tu estancia se sienta ligera desde antes de llegar.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4">
        {services.map(([number, title, description]) => (
          <article class="border-b border-[#cfc4b5] py-9 sm:px-6 sm:odd:border-r lg:border-r lg:border-b-0 lg:first:pl-0 lg:last:border-r-0">
            <span class="text-xs font-bold text-terracotta">{number}</span>
            <h3 class="mt-10 font-serif text-2xl">{title}</h3>
            <p class="mt-4 text-sm leading-6 text-muted">{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page py-24 lg:py-40" id="ubicacion">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_.9fr] lg:gap-24">
      <div class="relative min-h-[520px] overflow-hidden bg-sand sm:min-h-[650px]">
        <img class="absolute inset-0 size-full object-cover object-center" src={balconiesImage.src} alt="Balcones interiores y patio del Hotel Casa Theo" width={balconiesImage.width} height={balconiesImage.height} loading="lazy" decoding="async" />
        <div class="absolute right-0 bottom-0 max-w-[15rem] bg-canvas p-6"><p class="font-serif text-2xl leading-tight">A pasos del centro histórico.</p></div>
      </div>
      <div>
        <p class="eyebrow">Nuestra ubicación</p>
        <h2 class="font-serif text-[clamp(2.8rem,5vw,4.8rem)] leading-[.98] tracking-[-.04em]">Arequipa comienza al abrir la puerta.</h2>
        <p class="mt-7 max-w-md leading-7 text-muted">Estamos en un barrio sereno, conectado con la Plaza de Armas, el Monasterio de Santa Catalina y las mesas que mejor cuentan la cocina local.</p>
        <dl class="mt-10 grid grid-cols-2 gap-5 border-y border-line py-7">
          <div><dt class="text-[.62rem] font-bold tracking-[.14em] text-muted uppercase">Plaza de Armas</dt><dd class="mt-2 font-serif text-2xl">8 min</dd></div>
          <div><dt class="text-[.62rem] font-bold tracking-[.14em] text-muted uppercase">Aeropuerto</dt><dd class="mt-2 font-serif text-2xl">25 min</dd></div>
        </dl>
        <a class="button-primary mt-9" href="https://maps.google.com/?q=Arequipa,+Peru" target="_blank" rel="noreferrer">Ver en Google Maps <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-pine py-24 text-center text-white lg:py-32">
    <div class="absolute inset-0 opacity-15 [background-image:radial-gradient(circle_at_center,white_1px,transparent_1px)] [background-size:20px_20px]"></div>
    <div class="container-page relative">
      <p class="mb-5 text-[.68rem] font-bold tracking-[.2em] text-sand uppercase">Tu casa en Arequipa</p>
      <h2 class="mx-auto max-w-4xl font-serif text-[clamp(3rem,6vw,6rem)] leading-[.94] tracking-[-.045em]">Haz espacio para unos días diferentes.</h2>
      <a class="button-primary mt-9" href="#reservar">Reservar estancia</a>
    </div>
  </section>
</Layout>
