---
const whatsappUrl = "https://wa.me/51989318651";
---

<a
  class="group fixed right-[max(1.25rem,env(safe-area-inset-right))] bottom-[max(1.25rem,env(safe-area-inset-bottom))] z-40 grid size-14 place-items-center rounded-full bg-white p-2 shadow-[0_10px_30px_rgba(21,39,31,.24)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_14px_34px_rgba(21,39,31,.32)] sm:size-16"
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar con Hotel Casa Theo por WhatsApp"
>
  <span class="pointer-events-none absolute right-[calc(100%+.75rem)] hidden whitespace-nowrap rounded-sm bg-pine-dark px-3 py-2 text-xs font-semibold text-white opacity-0 shadow-lg transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100 sm:block" aria-hidden="true">Escríbenos por WhatsApp</span>
  <img class="size-full" src="/icons/wasapIcon.svg" alt="" width="128" height="128" aria-hidden="true" />
</a>
