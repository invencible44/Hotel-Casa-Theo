---
import logoCasaTheo from "../assets/brand/logo-casa-theo.webp";

const links = [
  { label: "La casa", href: "#la-casa", translationKey: "nav.house" },
  { label: "Habitaciones", href: "#habitaciones", translationKey: "nav.rooms" },
  { label: "Experiencias", href: "#experiencias", translationKey: "nav.experiences" },
  { label: "Galería", href: "#galeria", translationKey: "nav.gallery" },
  { label: "Ubicación", href: "#ubicacion", translationKey: "nav.location" },
];
---

<footer class="bg-pine-dark text-white">
  <div
    class="container-page grid gap-14 py-18 sm:grid-cols-2 lg:grid-cols-[1.4fr_.65fr_.8fr_auto] lg:py-24"
  >
    <div>
      <a
        class="inline-flex"
        href="#inicio"
        aria-label="Hotel Casa Theo, ir al inicio"
      >
        <img
          class="h-28 w-auto object-contain brightness-0 invert"
          src={logoCasaTheo.src}
          alt="Hotel Casa Theo"
          width={logoCasaTheo.width}
          height={logoCasaTheo.height}
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="mt-5 max-w-sm text-sm leading-7 text-white/60" data-i18n="footer.copy">
        Una casa tranquila desde donde descubrir el carácter, la arquitectura y
        los sabores de Arequipa.
      </p>
    </div>
    <nav aria-label="Navegación de pie de página">
      <h2
        class="mb-5 text-[.65rem] font-bold tracking-[.18em] text-sand uppercase"
      >
        <span data-i18n="footer.explore">Explora</span>
      </h2>
      {
        links.map((link) => (
          <a
            class="mb-3 block text-sm text-white/70 transition hover:text-white"
            href={link.href}
            data-i18n={link.translationKey}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <address class="not-italic">
      <h2
        class="mb-5 text-[.65rem] font-bold tracking-[.18em] text-sand uppercase"
      >
        <span data-i18n="footer.contact">Contacto</span>
      </h2>
      <p class="text-sm leading-7 text-white/70">
        <span data-i18n="footer.address">Arequipa, Perú</span><br /><a class="hover:text-white" href="tel:+51989318651"
          >+51 989 318 651</a
        ><br /><a class="hover:text-white" href="mailto:hola@casatheo.pe"
          >hola@casatheo.pe</a
        >
      </p>
    </address>
    <nav
      class="flex items-start gap-3 lg:justify-end"
      aria-label="Redes sociales"
      data-i18n-aria-label="footer.social"
    >
      <a
        class="grid size-11 place-items-center rounded-full border border-white/25 text-white/70 transition duration-300 hover:-translate-y-0.5 hover:border-white hover:text-white"
        href="https://www.facebook.com/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visitar Facebook de Casa Theo"
        data-i18n-aria-label="footer.facebook"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M13.7 22v-8.8h3l.45-3.45H13.7v-2.2c0-1 .28-1.68 1.72-1.68h1.84V2.8a24.5 24.5 0 0 0-2.68-.14c-2.65 0-4.47 1.62-4.47 4.59v2.5h-3v3.45h3V22h3.59Z"></path>
        </svg>
      </a>
      <a
        class="grid size-11 place-items-center rounded-full border border-white/25 text-white/70 transition duration-300 hover:-translate-y-0.5 hover:border-white hover:text-white"
        href="https://www.instagram.com/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visitar Instagram de Casa Theo"
        data-i18n-aria-label="footer.instagram"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
      <a
        class="grid size-11 place-items-center rounded-full border border-white/25 text-white/70 transition duration-300 hover:-translate-y-0.5 hover:border-white hover:text-white"
        href="https://www.tiktok.com/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Visitar TikTok de Casa Theo"
        data-i18n-aria-label="footer.tiktok"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M15.25 2.5h3.1a4.75 4.75 0 0 0 3.15 3.87v3.12a7.75 7.75 0 0 1-3.15-1.08v6.22A6.87 6.87 0 1 1 12.4 7.8v3.2a3.75 3.75 0 1 0 2.85 3.63V2.5Z"></path>
        </svg>
      </a>
    </nav>
  </div>
  <div
    class="container-page flex flex-col gap-3 border-t border-white/10 py-6 text-[.68rem] text-white/45 sm:flex-row sm:justify-between"
  >
    <p data-i18n="footer.rights">© 2026 Casa Theo. Todos los derechos reservados.</p>
    <p data-i18n="footer.place">Hotel boutique · Arequipa, Perú</p>
  </div>
</footer>
