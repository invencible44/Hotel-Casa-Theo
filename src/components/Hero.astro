---
import { Image } from "astro:assets";
import heroImage from "../assets/photos/hotel-courtyard-hero.webp";
import darkHeroImage from "../assets/photos/patioOscuro.png";
---

<section class="relative isolate min-h-[760px] overflow-hidden bg-pine text-white lg:min-h-[820px]" id="inicio">
  <img
    class="absolute inset-0 size-full scale-100 object-cover object-center opacity-100 transition-[opacity,transform] duration-[1500ms] ease-out dark:scale-[1.01] dark:opacity-0"
    src={heroImage.src}
    alt="Jardín central y arquitectura interior del Hotel Casa Theo"
    width={heroImage.width}
    height={heroImage.height}
    loading="eager"
    fetchpriority="high"
  />
  <Image
    class="absolute inset-0 size-full scale-[1.01] object-cover object-center opacity-0 transition-[opacity,transform] duration-[1500ms] ease-out dark:scale-100 dark:opacity-100"
    src={darkHeroImage}
    alt=""
    aria-hidden="true"
    width={heroImage.width}
    height={heroImage.height}
    fit="cover"
    position="center"
    format="webp"
    quality={84}
    loading="eager"
    decoding="async"
  />
  <div class="absolute inset-0 bg-linear-to-r from-pine-dark/90 via-pine-dark/48 to-transparent"></div>
  <div class="absolute inset-0 bg-linear-to-t from-pine-dark/55 via-transparent to-pine-dark/20"></div>

  <div class="container-page relative flex min-h-[760px] items-end pt-32 pb-48 sm:pb-44 lg:min-h-[820px] lg:pb-44">
    <div class="max-w-3xl">
      <p class="mb-5 text-[.68rem] font-bold tracking-[.22em] text-sand uppercase" data-i18n="hero.eyebrow">Hospitalidad en el corazón de Arequipa</p>
      <h1 class="font-serif text-[clamp(3.8rem,8.5vw,8.2rem)] leading-[.86] tracking-[-.055em] text-balance"><span data-i18n="hero.title1">Una casa para</span><br /><em class="font-normal" data-i18n="hero.title2">sentir la ciudad.</em></h1>
      <div class="mt-8 flex flex-col items-start gap-6 sm:flex-row sm:items-center">
        <a class="button-primary" href="#habitaciones" data-i18n="hero.rooms">Descubrir habitaciones</a>
        <p class="max-w-sm text-sm leading-6 text-white/75" data-i18n="hero.copy">Arquitectura de sillar, calma cotidiana y una mirada íntima a la Ciudad Blanca.</p>
      </div>
    </div>
  </div>

  <form class="absolute inset-x-0 bottom-5 z-10 mx-auto grid w-[calc(100%-2rem)] max-w-[1180px] grid-cols-2 gap-2 rounded-2xl border border-white/50 bg-canvas/95 p-2 text-ink shadow-[0_24px_70px_rgba(14,30,23,.32),0_4px_16px_rgba(14,30,23,.16)] ring-1 ring-pine-dark/5 backdrop-blur-xl sm:bottom-7 sm:w-[calc(100%-4rem)] lg:grid-cols-[1fr_1fr_.75fr_auto]" id="reservar" aria-label="Consultar disponibilidad" data-i18n-aria-label="booking.form">
    <span class="absolute -top-3 left-5 rounded-full bg-terracotta px-3 py-1 text-[.58rem] font-bold tracking-[.16em] text-white uppercase shadow-sm" data-i18n="booking.direct">Reserva directa</span>
    <label class="grid min-w-0 gap-1 rounded-xl bg-white/60 px-3 py-3 transition focus-within:bg-white focus-within:ring-1 focus-within:ring-terracotta/50 dark:bg-pine-dark/70 dark:focus-within:bg-pine-dark sm:px-5 lg:px-6 lg:py-4">
      <span class="text-[.62rem] font-bold tracking-[.14em] text-muted uppercase" data-i18n="booking.arrival">Llegada</span>
      <input class="min-h-7 w-full min-w-0 bg-transparent text-sm font-semibold outline-none" type="date" name="llegada" required />
    </label>
    <label class="grid min-w-0 gap-1 rounded-xl bg-white/60 px-3 py-3 transition focus-within:bg-white focus-within:ring-1 focus-within:ring-terracotta/50 dark:bg-pine-dark/70 dark:focus-within:bg-pine-dark sm:px-5 lg:px-6 lg:py-4">
      <span class="text-[.62rem] font-bold tracking-[.14em] text-muted uppercase" data-i18n="booking.departure">Salida</span>
      <input class="min-h-7 w-full min-w-0 bg-transparent text-sm font-semibold outline-none" type="date" name="salida" required />
    </label>
    <label class="grid min-w-0 gap-1 rounded-xl bg-white/60 px-3 py-3 transition focus-within:bg-white focus-within:ring-1 focus-within:ring-terracotta/50 dark:bg-pine-dark/70 dark:focus-within:bg-pine-dark sm:px-5 lg:px-6 lg:py-4">
      <span class="text-[.62rem] font-bold tracking-[.14em] text-muted uppercase" data-i18n="booking.guests">Huéspedes</span>
      <select class="min-h-7 w-full min-w-0 bg-transparent text-sm font-semibold outline-none" name="huespedes">
        <option data-i18n="booking.twoGuests">2 huéspedes</option><option data-i18n="booking.oneGuest">1 huésped</option><option data-i18n="booking.threeGuests">3 huéspedes</option><option data-i18n="booking.fourGuests">4 huéspedes</option>
      </select>
    </label>
    <button class="min-h-14 rounded-xl bg-pine px-4 text-xs font-bold tracking-[.1em] text-white uppercase shadow-sm transition duration-300 hover:-translate-y-0.5 hover:bg-pine-dark focus-visible:bg-pine-dark sm:px-8" type="submit" data-i18n="booking.availability">Ver disponibilidad</button>
  </form>
</section>
